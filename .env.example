# ---------------------------------------------------------------------------
# DM Gráfica Rápida — variables de entorno
# Copiar a .env y completar. NUNCA subir el .env real al repositorio.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Base de datos (Render PostgreSQL) ---
# URL interna que entrega Render para el servicio web (misma región).
DATABASE_URL=postgresql://usuario:clave@host:5432/base
# Poner en true solo si se conecta desde fuera de Render (URL externa).
DATABASE_SSL=false
# Si el proveedor usa una CA propia, pegar su certificado PEM (saltos como \n).
# No desactivar la validación del certificado TLS.
DATABASE_SSL_CA=
PG_POOL_MAX=8

# --- URLs públicas ---
# Dominio propio en producción. Sin barra final.
PUBLIC_BASE_URL=http://localhost:3000

# --- Mercado Pago ---
# sandbox = credenciales de prueba. production = credenciales reales.
MERCADOPAGO_MODE=sandbox
MERCADOPAGO_ACCESS_TOKEN=
# Secreto del webhook: Mercado Pago > "Notificaciones" > "Secret signature".
MERCADOPAGO_WEBHOOK_SECRET=
# Deja el checkout apagado hasta tener credenciales y probar el webhook.
CHECKOUT_ENABLED=false

# --- Emails (Resend) ---
# Requiere dominio propio verificado con SPF y DKIM en el DNS.
RESEND_API_KEY=
# Remitente verificado en Resend. Ej: "DM Gráfica Rápida <ventas@dmgraficarapida.com.uy>"
EMAIL_FROM=
# A quién se avisa cuando entra una orden nueva (administrador).
ADMIN_NOTIFICATION_EMAIL=

# --- Supabase Storage (imágenes del catálogo) ---
# URL del proyecto: https://xxxx.supabase.co
SUPABASE_URL=
# Service role key. SOLO en el servidor. Nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Nombre del bucket público donde se guardan las fotos de producto.
SUPABASE_BUCKET=productos

# Las sesiones usan tokens aleatorios guardados como hash en PostgreSQL.
# No requieren SESSION_SECRET.
